{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string"
    },
    "workspace_epoch": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string"
    },
    "job_type": {
      "enum": [
        "reconcile",
        "normalize",
        "historical",
        "mail_draft",
        "todo_assist",
        "knowledge_assist"
      ]
    },
    "rules_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "mail_batch_id": {
          "type": "string"
        },
        "todo_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "historical": {
          "type": "boolean"
        }
      },
      "required": [
        "mail_batch_id",
        "todo_ids",
        "historical"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "workspace_epoch",
    "job_id",
    "input_sha256",
    "job_type",
    "rules_version",
    "created_at",
    "timezone",
    "scope",
    "context"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "mail_draft"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "type": "object",
            "required": [
              "target_message_id",
              "messages",
              "knowledge",
              "execution",
              "instructions",
              "material_hash"
            ]
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "job_type": {
              "const": "todo_assist"
            }
          }
        },
        "then": {
          "properties": {
            "context": {
              "type": "object",
              "required": [
                "sources",
                "todos",
                "instructions",
                "execution"
              ]
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "job_type": {
                "const": "knowledge_assist"
              }
            }
          },
          "then": {
            "properties": {
              "context": {
                "required": [
                  "material",
                  "subject_id",
                  "fingerprint",
                  "instructions",
                  "execution"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "context": {
                "type": "object",
                "required": [
                  "messages",
                  "todos",
                  "progress_logs",
                  "human_decisions",
                  "customers",
                  "cases",
                  "knowledge",
                  "taxonomy"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
